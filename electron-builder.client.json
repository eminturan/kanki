{
  "appId": "com.kanki.app",
  "productName": "Kanki",
  "directories": {
    "output": "dist/client"
  },
  "extraMetadata": {
    "kankiVariant": "client",
    "kankiDefaultServer": ""
  },
  "npmRebuild": false,
  "files": [
    "src/**/*",
    "build/icon.png",
    "package.json",
    "!node_modules/uiohook-napi/build/**",
    "!node_modules/uiohook-napi/libuiohook/**",
    "!node_modules/uiohook-napi/src/**",
    "!node_modules/@ngrok/**"
  ],
  "asarUnpack": [
    "node_modules/uiohook-napi/**",
    "node_modules/node-gyp-build/**",
    "node_modules/koffi/**",
    "node_modules/@koromix/**"
  ],
  "mac": {
    "category": "public.app-category.social-networking",
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64",
          "x64"
        ]
      }
    ],
    "icon": "build/icon.png",
    "hardenedRuntime": false,
    "identity": "-",
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Kanki, arkadaşlarınla konuşabilmen için mikrofona erişmek istiyor.",
      "NSCameraUsageDescription": "Kanki, kanaldaki arkadaşlarına kameranı gösterebilmen için kameraya erişmek istiyor.",
      "NSScreenCaptureUsageDescription": "Kanki, ekranını paylaşabilmen için ekran kaydı iznine ihtiyaç duyar.",
      "NSAudioCaptureUsageDescription": "Kanki, ekran paylaşırken sistem sesini iletebilmek için ses kaydı iznine ihtiyaç duyar.",
      "NSAppleEventsUsageDescription": "Kanki, Spotify'da çalan şarkıyı adının altında gösterebilmek için Spotify'a hangi şarkının çaldığını sorar."
    }
  },
  "dmg": {
    "artifactName": "Kanki-mac-${arch}.${ext}"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "Kanki-Setup.${ext}",
    "shortcutName": "Kanki"
  },
  "portable": {
    "artifactName": "Kanki-Portable.${ext}"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "kanki-app",
      "repo": "kanki-app.github.io",
      "releaseType": "release"
    }
  ],
  "protocols": [
    {
      "name": "Kanki",
      "schemes": [
        "kanki"
      ]
    }
  ]
}
