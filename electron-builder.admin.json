{
  "appId": "com.kanki.admin",
  "productName": "Kanki Admin",
  "directories": {
    "output": "dist/admin"
  },
  "extraMetadata": {
    "kankiVariant": "admin",
    "kankiDefaultServer": ""
  },
  "npmRebuild": false,
  "files": [
    "src/**/*",
    "server/**/*",
    "build/icon-admin.png",
    "package.json",
    "!node_modules/uiohook-napi/build/**",
    "!node_modules/uiohook-napi/libuiohook/**",
    "!node_modules/uiohook-napi/src/**"
  ],
  "asarUnpack": [
    "node_modules/uiohook-napi/**",
    "node_modules/node-gyp-build/**",
    "node_modules/@ngrok/**",
    "node_modules/koffi/**",
    "node_modules/@koromix/**"
  ],
  "mac": {
    "category": "public.app-category.social-networking",
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64",
          "x64"
        ]
      }
    ],
    "icon": "build/icon-admin.png",
    "hardenedRuntime": false,
    "identity": "-",
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Kanki, arkadaşlarınla konuşabilmen için mikrofona erişmek istiyor.",
      "NSCameraUsageDescription": "Kanki, kanaldaki arkadaşlarına kameranı gösterebilmen için kameraya erişmek istiyor.",
      "NSScreenCaptureUsageDescription": "Kanki, ekranını paylaşabilmen için ekran kaydı iznine ihtiyaç duyar.",
      "NSAudioCaptureUsageDescription": "Kanki, ekran paylaşırken sistem sesini iletebilmek için ses kaydı iznine ihtiyaç duyar."
    }
  },
  "dmg": {
    "artifactName": "Kanki-Admin-mac-${arch}.${ext}"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icon-admin.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "Kanki-Admin-Setup.${ext}",
    "shortcutName": "Kanki Admin"
  },
  "portable": {
    "artifactName": "Kanki-Admin-Portable.${ext}"
  },
  "publish": null
}
