{
  "name": "kanki",
  "productName": "Kanki",
  "version": "1.0.46",
  "description": "Arkadaşlarla sesli sohbet ve yüksek kaliteli ekran paylaşımı (macOS + Windows)",
  "main": "src/main/main.js",
  "author": "Kanki",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "start:client": "KANKI_VARIANT=client electron .",
    "server": "node server/server.js",
    "dist:admin:mac": "electron-builder --mac --config electron-builder.admin.json",
    "dist:admin:win": "npm install --no-save --force @ngrok/ngrok-win32-x64-msvc@1.7.0 && electron-builder --win --config electron-builder.admin.json",
    "dist:client:mac": "electron-builder --mac --config electron-builder.client.json",
    "dist:client:win": "electron-builder --win --config electron-builder.client.json",
    "dist": "npm run dist:client:mac && npm run dist:client:win && npm run dist:admin:mac && npm run dist:admin:win"
  },
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.7",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "terser": "^5.51.2"
  },
  "kankiVariant": "admin"
}
